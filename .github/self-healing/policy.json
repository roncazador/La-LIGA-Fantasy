{
  "version": 1,
  "mode": "safe-autonomous",
  "allowedPaths": [
    "src/**",
    "scripts/**",
    "*.mjs",
    "*.js",
    "*.json",
    ".github/workflows/*.yml"
  ],
  "blockedPaths": [
    ".env",
    ".env.*",
    "*.pem",
    "*.key",
    "credentials.json"
  ],
  "maxChangedFiles": 8,
  "maxPatchLines": 500,
  "maxAttemptsPerFailure": 2,
  "requireTests": true,
  "requireNoSecrets": true,
  "readOnlyFantasyPolicy": true,
  "autoMerge": false
}
