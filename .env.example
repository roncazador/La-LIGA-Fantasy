# Configuración no sensible
NODE_ENV=production
LALIGA_API_BASE_URL=https://fantasy-api.llt-services.com
LALIGA_COMPETITION_ID=1
SESSION_COOKIE_NAME=fm_session
FOOTBALL_DATA_COMPETITION=PD
FOOTBALL_DATA_DAYS=30

# Football-data.org
# Token privado. Nunca lo subas a GitHub.
FOOTBALL_DATA_TOKEN=

# Sportmonks
# Credencial opcional para cobertura avanzada. Se configura fuera del repositorio.
SPORTMONKS_API_TOKEN=
SPORTMONKS_API_BASE_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_LALIGA_LEAGUE_ID=
SPORTMONKS_LALIGA_SEASON_ID=

# API-Football / API-Sports
# Credencial opcional para contraste de datos. Se configura fuera del repositorio.
API_FOOTBALL_API_KEY=
API_FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_LALIGA_LEAGUE_ID=140
API_FOOTBALL_LALIGA_SEASON=2026

# Opta / Stats Perform
# Servicio comercial: requiere credenciales y el endpoint habilitado en tu contrato.
OPTA_API_TOKEN=
OPTA_API_BASE_URL=
OPTA_FIXTURES_PATH=
OPTA_LALIGA_COMPETITION_ID=

# IA externa opcional para futuras tareas de síntesis/revisión en servidor.
# Nunca se utiliza para exponer secretos al cliente.
OPENAI_API_KEY=
AI_FEEDBACK_ENABLED=false
AI_FEEDBACK_MODEL=

# Automatización y cultivo continuo
AUTOMATION_ENABLED=true
CULTIVOS_ENABLED=true

# OAuth oficial de LALIGA: rellenar solo con valores reales proporcionados/aceptados por el proveedor.
LALIGA_AUTHORIZE_URL=
LALIGA_OAUTH_CLIENT_ID=
LALIGA_REDIRECT_URI=
LALIGA_SIGNIN_POLICY=B2C_1A_5ULAIP_PARAMETRIZED_SIGNIN
LALIGA_TOKEN_URL=https://login.laliga.es/laligadspprob2c.onmicrosoft.com/oauth2/v2.0/token

# Opcionales
IOS_SUCCESS_REDIRECT=laligafantasy://auth-complete
FRONTEND_URL=/
SECURE_COOKIE=true
ALLOW_ORIGIN=
